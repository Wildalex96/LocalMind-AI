# Never commit real secrets. These are read from the process environment.
# Local providers need no API key.
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=local-model
OLLAMA_MODEL=qwen3:4b

# Free-tier cloud providers. Create your own free keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Paid providers are intentionally not used by free-auto.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
